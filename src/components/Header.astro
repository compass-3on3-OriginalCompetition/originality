---
import { SITE } from '@/lib/site';
---

<header class="header">
  <div class="container inner">
    <a href="/" class="logo">
      {SITE.name}
    </a>
    <nav aria-label="メイン">
      <a href="/">ホーム</a>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
  }
  .logo {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 16px;
  }
</style>
